    "sourceProject": {
      "files": [
        {
          "path": "preferences-window.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\ntemplate $SolanumPreferencesWindow : Adw.PreferencesWindow {\n  search-enabled: false;\n\n  Adw.PreferencesPage {\n    Adw.PreferencesGroup {\n      title: _(\"Session Length\");\n      description: _(\"The length of each session type in minutes. Changes apply to the next session of each type.\");\n\n      Adw.SpinRow lap_spin {\n        title: _(\"Lap Length\");\n        numeric: true;\n        adjustment: Gtk.Adjustment adjustment {\n          lower: 1;\n          upper: 99;\n          step-increment: 1;\n        };\n      }\n\n      Adw.SpinRow short_break_spin {\n        title: _(\"Short Break Length\");\n        numeric: true;\n        adjustment: Gtk.Adjustment {\n          lower: bind adjustment.lower;\n          upper: bind adjustment.upper;\n          step-increment: bind adjustment.step-increment;\n        };\n      }\n\n      Adw.SpinRow long_break_spin {\n        title: _(\"Long Break Length\");\n        numeric: true;\n        adjustment: Gtk.Adjustment {\n          lower: bind adjustment.lower;\n          upper: bind adjustment.upper;\n          step-increment: bind adjustment.step-increment;\n        };\n      }\n    }\n\n    Adw.PreferencesGroup {\n      Adw.SpinRow session_count_spin {\n        title: _(\"Sessions Until Long Break\");\n        numeric: true;\n        adjustment: Gtk.Adjustment {\n          lower: bind adjustment.lower;\n          upper: bind adjustment.upper;\n          step-increment: bind adjustment.step-increment;\n        };\n      }\n    }\n\n    Adw.PreferencesGroup {\n      Adw.SwitchRow fullscreen_switch {\n        title: _(\"Fullscreen During Breaks\");\n      }\n    }\n  }\n}\n"
        },
        {
          "path": "window.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\ntemplate $SolanumWindow : Adw.ApplicationWindow {\n  default-width: 360;\n  default-height: 360;\n  height-request: 294;\n  default-widget: timer_button;\n  content: Adw.ToolbarView {\n    [top]\n    Adw.HeaderBar {\n      show-title: false;\n    }\n\n    content: Gtk.Box {\n      orientation: vertical;\n      valign: center;\n      vexpand: true;\n      spacing: 6;\n      styles [\"main-box\"]\n\n      Gtk.Label lap_label {\n        styles [\"heading\", \"dim-label\"]\n      }\n\n      Gtk.Label timer_label {\n        styles [\"timer-label\", \"accent\", \"blinking\"]\n      }\n\n      Gtk.CenterBox {\n        margin-bottom: 48;\n        halign: center;\n\n        [center]\n        Gtk.Box {\n          spacing: 12;\n          halign: center;\n\n          Gtk.Button timer_button {\n            tooltip-text: _(\"Toggle Timer\");\n            icon-name: \"media-playback-start-symbolic\";\n            action-name: \"win.toggle-timer\";\n            valign: center;\n            styles [\"circular\", \"large\", \"suggested-action\"]\n          }\n\n          Gtk.Button skip_button {\n            tooltip-text: _(\"Skip\");\n            icon-name: \"media-seek-forward-symbolic\";\n            action-name: \"win.skip\";\n            valign: center;\n            styles [\"circular\", \"large\"]\n          }\n        }\n\n        [end]\n        Gtk.MenuButton menu_button {\n          primary: true;\n          tooltip-text: _(\"Main Menu\");\n          menu-model: app_menu;\n          icon-name: \"open-menu-symbolic\";\n          halign: end;\n          valign: center;\n          margin-start: 12;\n          styles [\"circular\"]\n        }\n      }\n    };\n  };\n\n  Adw.Breakpoint large_text_bp {\n    condition (\"min-width: 800sp and min-height: 800sp\")\n  }\n}\n\nmenu app_menu {\n  section {\n    item (_(\"Reset Sessions\"), \"win.reset\")\n  }\n\n  section {\n    item (_(\"_Preferences\"), \"app.preferences\")\n    item (_(\"_Keyboard Shortcuts\"), \"win.show-help-overlay\")\n    item (_(\"_About Solanum\"), \"app.about\")\n  }\n}\n"
        }
      ],
