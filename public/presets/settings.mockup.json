    "sourceProject": {
      "files": [
        {
          "path": "cc-panel-list.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\ntemplate $CcPanelList: Adw.Bin {\n  Stack stack {\n    vhomogeneous: false;\n    hhomogeneous: true;\n    transition-type: slide_left_right;\n\n    StackPage {\n      name: \"main\";\n\n      child: ListBox main_listbox {\n        accessibility {\n          label: _(\"Settings categories\");\n        }\n\n        row-activated => $row_activated_cb();\n\n        styles [\n          \"navigation-sidebar\",\n        ]\n      };\n    }\n\n    StackPage {\n      name: \"search\";\n\n      child: ListBox search_listbox {\n        row-activated => $search_row_activated_cb();\n        keynav-failed => $cc_util_keynav_propagate_up();\n\n        styles [\n          \"navigation-sidebar\",\n        ]\n\n        [placeholder]\n        Adw.StatusPage {\n          icon-name: \"edit-find-symbolic\";\n          title: _(\"No Results Found\");\n          description: _(\"Try a different search\");\n\n          styles [\n            \"compact\",\n          ]\n        }\n      };\n    }\n  }\n}\n"
        },
        {
          "path": "cc-panel.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\ntemplate $CcPanel: Adw.NavigationPage {\n}\n"
        },
        {
          "path": "cc-window.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\ntemplate $CcWindow: Adw.ApplicationWindow {\n  default-width: 980;\n  default-height: 640;\n\n  Adw.Breakpoint break_point {\n    condition (\"max-width: 550sp\")\n\n    setters {\n      split_view.collapsed: true;\n    }\n  }\n\n  content: Adw.NavigationSplitView split_view {\n    notify::collapsed => $on_split_view_collapsed_changed_cb(template);\n\n    sidebar: Adw.NavigationPage panel_list_page {\n      title: _(\"Settings\");\n\n      child: Adw.ToolbarView {\n        [top]\n        Adw.HeaderBar {\n          ToggleButton search_button {\n            icon-name: \"edit-find-symbolic\";\n\n            /* Translators: this is a verb. */\n            tooltip-text: _(\"Search\");\n          }\n\n          [end]\n          MenuButton {\n            icon-name: \"open-menu-symbolic\";\n            menu-model: primary_menu;\n            primary: true;\n            tooltip-text: _(\"Main Menu\");\n          }\n        }\n\n        [top]\n        SearchBar search_bar {\n          search-mode-enabled: bind search_button.active bidirectional;\n\n          SearchEntry search_entry {\n            hexpand: true;\n            placeholder-text: _(\"Search settings\");\n            activate => $search_entry_activate_cb(template);\n\n            EventControllerKey {\n              key-pressed => $search_entry_key_pressed_cb(template);\n            }\n          }\n        }\n\n        content: ScrolledWindow {\n          hscrollbar-policy: never;\n\n          $CcPanelList panel_list {\n            search-mode: bind search_bar.search-mode-enabled no-sync-create bidirectional;\n            search-query: bind search_entry.text no-sync-create;\n            show-panel => $show_panel_cb(template);\n          }\n        };\n      };\n    };\n\n    content: Adw.NavigationPage {\n      child: Adw.NavigationView navigation {\n      };\n    };\n  };\n}\n\nmenu primary_menu {\n  section {\n    item {\n      label: _(\"_Keyboard Shortcuts\");\n      action: \"app.shortcuts\";\n    }\n\n    item {\n      label: _(\"_Help\");\n      action: \"app.help\";\n    }\n\n    item {\n      label: _(\"_About Settings\");\n      action: \"app.about\";\n    }\n  }\n}\n"
        },
        {
          "path": "shortcuts-dialog.blp",
          "content": "using Gtk 4.0;\nusing Adw 1;\n\nAdw.ShortcutsDialog shortcuts_dialog {\n  Adw.ShortcutsSection {\n    title: C_(\"shortcuts dialog\", \"General\");\n\n    Adw.ShortcutsItem {\n      accelerator: \"<Control>Q\";\n      title: C_(\"shortcuts dialog\", \"Quit\");\n    }\n\n    Adw.ShortcutsItem {\n      accelerator: \"<Control>F\";\n      title: C_(\"shortcuts dialog\", \"Search\");\n    }\n\n    Adw.ShortcutsItem {\n      action-name: \"app.help\";\n      title: C_(\"shortcuts dialog\", \"Show help\");\n    }\n\n    Adw.ShortcutsItem {\n      action-name: \"app.shortcuts\";\n      title: C_(\"shortcuts dialog\", \"Keyboard shortcuts\");\n    }\n  }\n\n  Adw.ShortcutsSection {\n    title: C_(\"shortcuts dialog\", \"Panels\");\n\n    Adw.ShortcutsItem {\n      accelerator: \"<Alt>Left\";\n      direction: ltr;\n      title: C_(\"shortcuts dialog\", \"Go back to previous panel\");\n    }\n\n    Adw.ShortcutsItem {\n      accelerator: \"<Alt>Right\";\n      direction: rtl;\n      title: C_(\"shortcuts dialog\", \"Go back to previous panel\");\n    }\n  }\n\n  Adw.ShortcutsSection {\n    title: C_(\"shortcuts dialog\", \"Search\");\n\n    Adw.ShortcutsItem {\n      accelerator: \"Escape\";\n      title: C_(\"shortcuts dialog\", \"Cancel search\");\n    }\n  }\n}\n"
        }
      ],
      "roots": [
        "cc-window.blp#15"
      ],
